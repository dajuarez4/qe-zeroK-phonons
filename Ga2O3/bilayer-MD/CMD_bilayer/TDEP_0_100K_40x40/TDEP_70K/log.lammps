# Equilibrate for 5 ps at 70 K.
velocity        all create 70.0 707070 mom yes rot no dist gaussian
fix             eq all nvt temp 70.0 70.0 0.1
fix             mom1 all momentum 100 linear 1 1 1
run             5000
