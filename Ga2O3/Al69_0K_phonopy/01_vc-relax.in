&CONTROL
  calculation = 'vc-relax'
  prefix      = 'Al69-Ga2O3-relax'
  outdir      = './tmp_relax'
  pseudo_dir  = './pseudo'
  verbosity   = 'high'
  tstress     = .true.
  tprnfor     = .true.
  forc_conv_thr = 1.0d-4
  nstep       = 300
/

&SYSTEM
  ibrav       = 0
  nat         = 40
  ntyp        = 3
  input_dft   = 'PBE'
  ecutwfc     = 80
  ecutrho     = 640
  occupations = 'fixed'
/

&ELECTRONS
  electron_maxstep = 300
  conv_thr         = 1.0d-10
  mixing_beta      = 0.20
  mixing_mode      = 'local-TF'
  diagonalization  = 'david'
/

&IONS
  ion_dynamics = 'bfgs'
/

&CELL
  cell_dynamics  = 'bfgs'
  press          = 0.0
  press_conv_thr = 0.2
  cell_dofree    = 'all'
/

ATOMIC_SPECIES
O   15.999  O.pbe-n-kjpaw_psl.1.0.0.UPF
Ga  69.723  Ga.pbe-dn-kjpaw_psl.1.0.0.UPF
Al  26.982  Al.pbe-n-kjpaw_psl.1.0.0.UPF

