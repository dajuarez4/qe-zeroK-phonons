# Equilibrate for 5 ps at 80 K.
velocity        all create 80.0 808080 mom yes rot no dist gaussian
fix             eq all nvt temp 80.0 80.0 0.1
fix             mom1 all momentum 100 linear 1 1 1
run             5000
