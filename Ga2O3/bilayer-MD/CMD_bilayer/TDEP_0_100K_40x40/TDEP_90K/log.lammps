# Equilibrate for 5 ps at 90 K.
velocity        all create 90.0 909090 mom yes rot no dist gaussian
fix             eq all nvt temp 90.0 90.0 0.1
fix             mom1 all momentum 100 linear 1 1 1
run             5000
