&CONTROL
  calculation = 'scf'
  prefix      = 'alpha-Fe2O3-V106-fd'
  outdir      = './tmp'
  pseudo_dir  = '../../../pseudo'
  verbosity   = 'high'
  tstress     = .true.
  tprnfor     = .true.
  disk_io     = 'low'
/

&SYSTEM
  ibrav             = 0
  nat               = 80
  ntyp              = 3
  input_dft         = 'PBE'
  ecutwfc           = 80
  ecutrho           = 640
  occupations       = 'fixed'
  nspin             = 2
  tot_magnetization = 0.0
  starting_magnetization(2) =  0.80
  starting_magnetization(3) = -0.80
  lda_plus_u        = .true.
  Hubbard_U(2)      = 4.0
  Hubbard_U(3)      = 4.0
  U_projection_type = 'ortho-atomic'
  nosym             = .true.
  noinv             = .true.
/

&ELECTRONS
  electron_maxstep = 300
  conv_thr         = 1.0d-12
  mixing_beta      = 0.15
  mixing_mode      = 'local-TF'
  diagonalization  = 'david'
/

