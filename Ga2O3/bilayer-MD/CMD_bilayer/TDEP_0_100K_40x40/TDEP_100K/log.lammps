# Equilibrate for 5 ps at 100 K.
velocity        all create 100.0 1010100 mom yes rot no dist gaussian
fix             eq all nvt temp 100.0 100.0 0.1
fix             mom1 all momentum 100 linear 1 1 1
run             5000
