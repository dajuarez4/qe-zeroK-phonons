# --- DFT Control ---
UserBasis         true
PAO.BasisSize     DZP
PAO.EnergyShift   0.04 Ry
XC.functional     GGA
XC.authors        PBE
MeshCutoff        500 Ry
MaxSCFIterations  150
DM.Tolerance      1.0E-4
DM.MixingWeight   0.2
SolutionMethod    diagon

# --- Cálculos para Band Offset y DOS ---
SaveTotalPotential         .true.
SaveElectrostaticPotential .true.

# --- K-Points para la Supercelda 2x1x2 ---
%block kgrid_Monkhorst_Pack
   6   0   0   0.0
   0  12   0   0.0
   0   0   6   0.0
%endblock kgrid_Monkhorst_Pack

# --- Control de Relajación (Single-Point) ---
MD.TypeOfRun      CG
MD.NumCGsteps     0         # Mantiene la caja y átomos fijos
MD.VariableCell   .False.   
MD.MaxForceTol    0.01 eV/Ang
MD.TargetPressure 0.0 GPa

#-----------------------------------------------------------
#  Bands (β-Ga2O3 monoclínico, supercelda)
#-----------------------------------------------------------
BandLinesScale ReciprocalLatticeVectors
%block BandLines
