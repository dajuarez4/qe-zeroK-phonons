&CONTROL
  calculation   = 'relax'
  prefix        = 'Ga2O3-BL-001-relax'
  outdir        = './tmp/relax'
  pseudo_dir    = '../../pseudo'
  verbosity     = 'high'
  restart_mode  = 'from_scratch'
  nstep         = 150
  tstress       = .true.
  tprnfor       = .true.
  etot_conv_thr = 1.0d-5
  forc_conv_thr = 1.0d-4
/

&SYSTEM
  ibrav           = 0
  nat             = 10
  ntyp            = 2
  input_dft       = 'PBE'
  ecutwfc         = 80
  ecutrho         = 640
  occupations     = 'fixed'
  assume_isolated = '2D'
  nosym           = .true.
/

&ELECTRONS
  electron_maxstep = 200
  conv_thr         = 1.0d-10
  mixing_beta      = 0.2
  diagonalization  = 'david'
/

&IONS
  ion_dynamics    = 'bfgs'
  trust_radius_ini = 0.05
  trust_radius_max = 0.20
  trust_radius_min = 1.0d-4
/

ATOMIC_SPECIES
Ga  69.723  Ga.pbe-dn-kjpaw_psl.1.0.0.UPF
O   15.999  O.pbe-n-kjpaw_psl.1.0.0.UPF

