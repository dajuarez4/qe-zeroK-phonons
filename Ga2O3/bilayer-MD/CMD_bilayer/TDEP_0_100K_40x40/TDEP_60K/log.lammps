# Equilibrate for 5 ps at 60 K.
velocity        all create 60.0 606060 mom yes rot no dist gaussian
fix             eq all nvt temp 60.0 60.0 0.1
fix             mom1 all momentum 100 linear 1 1 1
run             5000
