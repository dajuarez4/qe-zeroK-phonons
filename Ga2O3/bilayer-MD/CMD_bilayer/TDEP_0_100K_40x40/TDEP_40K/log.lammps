# Equilibrate for 5 ps at 40 K.
velocity        all create 40.0 404040 mom yes rot no dist gaussian
fix             eq all nvt temp 40.0 40.0 0.1
fix             mom1 all momentum 100 linear 1 1 1
run             5000
