unfix           eq
unfix           mom1

# Produce 25 ps and save 26 snapshots separated by 1 ps.
reset_timestep  0
fix             prod all nvt temp 100.0 100.0 0.1
fix             mom2 all momentum 100 linear 1 1 1
compute         atom_pe all pe/atom
compute         atom_ke all ke/atom
dump            traj all custom 1000 trajectory_100K.lammpstrj id type xu yu zu fx fy fz c_atom_pe c_atom_ke
dump_modify     traj sort id
run             25000
