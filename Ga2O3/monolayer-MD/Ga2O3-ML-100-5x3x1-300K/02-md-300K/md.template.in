&CONTROL
  calculation  = 'md'
  prefix       = 'Ga2O3-ML-100-5x3x1-300K'
  outdir       = './tmp'
  pseudo_dir   = '../../pseudo'
  verbosity    = 'high'
  restart_mode = 'from_scratch'
  nstep        = 10000
  dt           = 20.0
  tstress      = .true.
  tprnfor      = .true.
  disk_io      = 'low'
/

&SYSTEM
  ibrav           = 0
  nat             = 75
  ntyp            = 2
  input_dft       = 'PBE'
  ecutwfc         = 80
  ecutrho         = 640
  occupations     = 'fixed'
  assume_isolated = '2D'
  nosym           = .true.
/

&ELECTRONS
  electron_maxstep = 200
  conv_thr         = 1.0d-8
  mixing_beta      = 0.2
  diagonalization  = 'david'
/

&IONS
  ion_dynamics      = 'verlet'
  ion_temperature   = 'svr'
  tempw             = 300.0
  nraise            = 200
  pot_extrapolation = 'second_order'
  wfc_extrapolation = 'second_order'
/

