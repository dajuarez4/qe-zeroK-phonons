# Equilibrate for 5 ps at 50 K.
velocity        all create 50.0 505050 mom yes rot no dist gaussian
fix             eq all nvt temp 50.0 50.0 0.1
fix             mom1 all momentum 100 linear 1 1 1
run             5000
