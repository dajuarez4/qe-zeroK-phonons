# Equilibrate for 5 ps at 20 K.
velocity        all create 20.0 204020 mom yes rot no dist gaussian
fix             eq all nvt temp 20.0 20.0 0.1
fix             mom1 all momentum 100 linear 1 1 1
run             5000
